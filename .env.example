# Google Analytics 4 measurement ID (Admin > Data streams > Web stream details).
# Leave unset locally — analytics only loads when this is present.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional. Web3Forms access key for contact / start-project submissions.
# lib/enquiry.ts already hardcodes the live key (Web3Forms keys are public by
# design), so only set this to override it after a rotation.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Website Launch promotion (/website-launch) ------------------------------

# Server-side Web3Forms access key for the promotion's enquiry route
# (app/api/website-launch/route.ts). Optional: with this unset the route falls
# back to the same public key the rest of the site's forms already use, so the
# page works on any deploy with no configuration. Set it to route promotion
# enquiries to a different inbox, or after a key rotation.
#
# Unlike NEXT_PUBLIC_WEB3FORMS_KEY this one is NOT exposed to the browser.
WEB3FORMS_ACCESS_KEY=

# DEVELOPMENT ONLY. Set to "mock" to accept enquiries, log them and deliver
# nothing, so the form can be tested end to end without emailing a real person.
# Every mock submission logs at error level so this cannot be left on quietly.
# NEVER set this in production: real enquiries would be accepted and discarded.
LAUNCH_ENQUIRY_TRANSPORT=
