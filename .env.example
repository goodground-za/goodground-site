# Google Analytics 4 measurement ID (Admin > Data streams > Web stream details).
# Leave unset locally — analytics only loads when this is present.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional. Web3Forms access key for contact / start-project submissions.
# lib/enquiry.ts already hardcodes the live key (Web3Forms keys are public by
# design), so only set this to override it after a rotation.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ---------------------------------------------------------------------------
# Outbound mail for the server-side form routes
# (/api/enquiry and /api/onboarding).
#
# These routes used to post to Web3Forms. That does not work from a server:
# the free plan refuses server-side calls, so every submission failed at the
# delivery step. They now send over GoodGround's own cPanel SMTP instead.
#
# Required in production. With any of the three unset, the routes report an
# honest failure rather than pretending a message was delivered.
#
# NOTE: this repo is public, so the real values are named here only as shapes.
# Get them from the Vercel project settings, or from the cPanel account.
#
# Authenticate as the dedicated web-form mailbox rather than the inbox a person
# reads, so automated form traffic stays out of it. MAIL_TO and MAIL_FROM both
# default to SMTP_USER, so set them only if the destination should differ from
# the sending mailbox.
SMTP_HOST=mail.<your-domain>
SMTP_PORT=465
SMTP_USER=<the web-form mailbox>
SMTP_PASS=<its password — set in Vercel, never commit it>

# Optional. Both default to SMTP_USER, which is what we want here.
# MAIL_TO=
# MAIL_FROM=

# ---------------------------------------------------------------------------
# v2 funnel: free AI check storage and spam protection (all optional).
#
# Upstash Redis holds the 30-day per-business record, the monthly free-check
# counter and the offer spaces taken. Either pair of names works: the Upstash
# ones, or the ones the Vercel Marketplace integration injects. With neither
# set, the form still works: requests are accepted and emailed, with no
# 30-day rule and no monthly cap, and the typed values in content/ are used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Cloudflare Turnstile on the free AI check form. Both are needed to turn it on
# (the public key is read at build time and also opens challenges.cloudflare.com
# in the CSP). With neither set, the honeypot and the 3-second rule still run.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
