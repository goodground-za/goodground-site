# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the vars and holds no secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design QA screenshots
.screenshots/

# local impeccable critique snapshots (QA state, like .screenshots) — but
# .impeccable/design.json itself is tracked: it's the durable DESIGN.md
# sidecar (tonal ramps, component snippets), not ephemeral QA output.
.impeccable/critique/

# SEO audit artefacts. The written reports (*.md) ARE tracked — see
# seo-audit/ACTION-PLAN.md and the run-*/ markdown. These are the generated
# binaries behind them: ~25MB of screenshots and exported PDFs that can be
# regenerated from a re-run and only bloat the repo.
seo-audit/**/screenshots/
seo-audit/*.pdf

# Unreferenced leftover from the /home-test experiment that was promoted
# sitewide (the route is gone). 16MB, nothing links to it, and it was never
# committed — so it has never shipped to production. Kept on disk rather than
# deleted, since this is the only copy.
public/videos/home-test-2-hero.mp4
